<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.hilos.ProcesadorController"
      alignment="CENTER" spacing="20"
      prefWidth="550" prefHeight="430">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Monitor de procesamiento empresarial"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <VBox spacing="12" alignment="CENTER">
        <Label text="Procesamiento de clientes"
               style="-fx-font-size: 16px;"/>

        <Label fx:id="lblEstadoClientes"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraClientes"
                     progress="0" prefWidth="420"/>

        <Label fx:id="lblPorcentajeClientes" text="0%"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarClientes"
                    text="Iniciar"
                    onAction="#iniciarClientes"/>

            <Button fx:id="btnDetenerClientes"
                    text="Detener"
                    onAction="#detenerClientes"
                    disable="true"/>
        </HBox>
    </VBox>

    <Separator prefWidth="450"/>

    <VBox spacing="12" alignment="CENTER">
        <Label text="Procesamiento de productos"
               style="-fx-font-size: 16px;"/>

        <Label fx:id="lblEstadoProductos"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraProductos"
                     progress="0" prefWidth="420"/>

        <Label fx:id="lblPorcentajeProductos" text="0%"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarProductos"
                    text="Iniciar"
                    onAction="#iniciarProductos"/>

            <Button fx:id="btnDetenerProductos"
                    text="Detener"
                    onAction="#detenerProductos"
                    disable="true"/>
        </HBox>
    </VBox>

    <Button fx:id="btnReiniciar"
            text="Reiniciar procesos"
            onAction="#reiniciarProceso"/>
</VBox>
